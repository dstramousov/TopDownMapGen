{
  "schema_version": "forest-asset-rules-v2",
  "condition_rules": [
    {
      "rule_id": "map_border_guard",
      "priority": 1000,
      "use_asset_families": [
        "edge_cut_safe_small",
        "deep_fill_clipped_optional",
        "shadow_inside_only"
      ],
      "avoid_asset_families": [
        "deep_canopy_cluster_128",
        "large_canopy_overhang_outside_canvas"
      ],
      "placement": {
        "bounds_policy": "reject_full_bounds_outside_canvas"
      }
    },
    {
      "rule_id": "forest_isolated_single",
      "priority": 950,
      "use_asset_families": [
        "single_small_pine",
        "young_pine",
        "round_bush",
        "stump"
      ],
      "placement": {
        "max_sprite_size_px": [
